{
    "$schema": "https://raw.githubusercontent.com/DanielGavin/ols/master/misc/ols.schema.json",
    "collections": [
        {
            "name": "src",
            "path": "./src"
        }
    ],
    "profile": "debug",
    "profiles": [
        {
            "name": "debug",
            "os": "linux",
            "checker_path": [
                "./src"
            ],
            "defines": {
                "ODIN_DEBUG": "true"
            }
        },
        {
            "name": "release",
            "os": "linux",
            "checker_path": [
                "./src"
            ],
            "defines": {
                "ODIN_DEBUG": "false"
            }
        }
    ],
    "checker_args": "-vet",
    "enable_checker_only_saved": true,
    "enable_format": true,
    "enable_hover": true,
    "enable_document_symbols": true,
    "enable_references": true,
    "enable_document_highlights": true,
    "enable_document_links": true,
    "enable_overload_resolution": true,
    "enable_fake_methods": true,
    "enable_completion_matching": true,
    "enable_auto_import": true,
    "enable_snippets": true,
    "enable_procedure_snippet": true,
    "enable_inlay_hints_params": true,
    "enable_inlay_hints_default_params": false,
    "enable_inlay_hints_implicit_return": true,
    "enable_semantic_tokens": true,
    "enable_code_action_invert_if": true,
    "struct_fields_underscore_visibility": "",
    "verbose": false
}